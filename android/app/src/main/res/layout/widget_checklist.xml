<?xml version="1.0" encoding="utf-8"?>
<!--
  Checklist widget (W5), in the shared Zero-Trust widget look
  (Zero-Trust-Core/android-widget-kit). ChecklistWidgetProvider fills the list
  only while "Show details on the home screen" is on and shows the lock panel
  otherwise.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checklist_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/checklist_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/checklist_title"
            style="@style/ZtWidget.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/widget_checklist"/>
        <TextView
            android:id="@+id/checklist_count"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <ListView
            android:id="@+id/checklist_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none"/>
        <TextView
            android:id="@+id/checklist_empty"
            style="@style/ZtWidget.Caption"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_checklist_empty"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/checklist_locked"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/zt_widget_tile_circle">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_zt_widget_lock"
                    android:tint="@color/zt_widget_on_surface_variant"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <TextView
                android:id="@+id/checklist_locked_text"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="4"
                android:text="@string/widget_checklist_hidden"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
