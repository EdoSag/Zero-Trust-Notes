<?xml version="1.0" encoding="utf-8"?>
<!-- What the Widgets menu shows (Android 12+). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/zt_widget_accent_circle"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_zt_widget_add"
        android:tint="@color/zt_widget_on_accent"
        android:contentDescription="@string/widget_new_note"/>
</FrameLayout>
