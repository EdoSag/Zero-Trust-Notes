<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the Checklist widget's preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:paddingStart="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/zt_widget_accent_circle">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_zt_widget_check"
            android:tint="@color/zt_widget_on_accent"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        style="@style/ZtWidget.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="@color/zt_widget_on_surface_variant"
        android:text="@string/widget_preview_item_3"/>
</LinearLayout>
