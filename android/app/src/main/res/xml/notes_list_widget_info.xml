<?xml version="1.0" encoding="utf-8"?>
<!-- Notes list (W4): from 2x2 up to the whole screen; the list scrolls. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_notes_list"
    android:previewLayout="@layout/widget_notes_list_preview"
    android:description="@string/notes_list_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
